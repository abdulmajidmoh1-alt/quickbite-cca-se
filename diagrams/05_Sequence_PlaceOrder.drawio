<mxfile host="app.diagrams.net"><diagram name="Sequence – Place Order"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1250" pageHeight="1720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="UML Sequence Diagram – Place an order with coupon and online payment" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Customer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c4" value="Web App&lt;br&gt;(Frontend)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="235" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c5" value="Supabase API /&lt;br&gt;Edge Function" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c6" value="PostgreSQL DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="625" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c7" value="Payment Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c8" value="Restaurant Staff" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontStyle=1;participant=umlActor;" vertex="1" parent="1"><mxGeometry x="1015" y="60" width="120" height="1540" as="geometry"/></mxCell><mxCell id="c9" value="1. Open cart, click Checkout" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="150" as="sourcePoint"/><mxPoint x="295" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="2. getCart(userId)" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="190" as="sourcePoint"/><mxPoint x="490" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="3. SELECT cart items" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="230" as="sourcePoint"/><mxPoint x="685" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="4. cart items" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="270" as="sourcePoint"/><mxPoint x="490" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="5. cart + subtotal" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="310" as="sourcePoint"/><mxPoint x="295" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="6. Enter coupon code" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="350" as="sourcePoint"/><mxPoint x="295" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="7. validateCoupon(code, subtotal)" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="390" as="sourcePoint"/><mxPoint x="490" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="8. SELECT coupon WHERE code" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="430" as="sourcePoint"/><mxPoint x="685" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="9. coupon record" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="470" as="sourcePoint"/><mxPoint x="490" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="alt  [coupon]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=110;height=24;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="1180" height="130" as="geometry"/></mxCell><mxCell id="c19" value="[coupon valid]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="150" y="538" width="400" height="20" as="geometry"/></mxCell><mxCell id="c20" value="10a. discount amount" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="570" as="sourcePoint"/><mxPoint x="295" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="585" width="1180" height="1" as="geometry"/></mxCell><mxCell id="c22" value="[invalid / expired / below minimum]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="150" y="590" width="400" height="20" as="geometry"/></mxCell><mxCell id="c23" value="10b. error message" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="615" as="sourcePoint"/><mxPoint x="295" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="10c. show coupon error, keep full price" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="635" as="sourcePoint"/><mxPoint x="100" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="11. Click Pay" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="680" as="sourcePoint"/><mxPoint x="295" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="12. createOrder(cart, coupon)" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="720" as="sourcePoint"/><mxPoint x="490" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="13. INSERT order (status = pending_payment)" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="760" as="sourcePoint"/><mxPoint x="685" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="14. create payment (order_ref, amount)" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="800" as="sourcePoint"/><mxPoint x="880" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="15. payment window" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="840" as="sourcePoint"/><mxPoint x="295" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="16. Enter payment details" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="880" as="sourcePoint"/><mxPoint x="880" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="[payment success]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="150" y="948" width="400" height="20" as="geometry"/></mxCell><mxCell id="c32" value="17a. payment response (success, signature)" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="980" as="sourcePoint"/><mxPoint x="490" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="18a. verify signature" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1020" as="sourcePoint"/><mxPoint x="490" y="1040" as="targetPoint"/><Array as="points"><mxPoint x="530" y="1020"/><mxPoint x="530" y="1040"/></Array></mxGeometry></mxCell><mxCell id="c34" value="19a. INSERT payment; UPDATE order = placed" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1065" as="sourcePoint"/><mxPoint x="685" y="1065" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="20a. DELETE cart items" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1105" as="sourcePoint"/><mxPoint x="685" y="1105" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="21a. order confirmation" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1145" as="sourcePoint"/><mxPoint x="295" y="1145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="22a. show &#x27;Order placed&#x27; + order ID" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1185" as="sourcePoint"/><mxPoint x="100" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="23a. new order notification" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1225" as="sourcePoint"/><mxPoint x="1075" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="alt  [restaurant]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=110;height=24;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1265" width="820" height="140" as="geometry"/></mxCell><mxCell id="c40" value="[accepts]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="500" y="1293" width="400" height="20" as="geometry"/></mxCell><mxCell id="c41" value="24a. accept order" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="1320" as="sourcePoint"/><mxPoint x="490" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="25a. UPDATE status = accepted" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1340" as="sourcePoint"/><mxPoint x="685" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="1353" width="820" height="1" as="geometry"/></mxCell><mxCell id="c44" value="[rejects]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="500" y="1357" width="400" height="20" as="geometry"/></mxCell><mxCell id="c45" value="24b. reject order" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="1380" as="sourcePoint"/><mxPoint x="490" y="1380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="25b. status = cancelled, payment = refunded" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1397" as="sourcePoint"/><mxPoint x="685" y="1397" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="1425" width="1180" height="1" as="geometry"/></mxCell><mxCell id="c48" value="[payment failed / cancelled]" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="150" y="1430" width="400" height="20" as="geometry"/></mxCell><mxCell id="c49" value="17b. payment response (failed)" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="1460" as="sourcePoint"/><mxPoint x="490" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="18b. INSERT payment (failed); order stays pending_payment" style="endArrow=block;endFill=1;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1500" as="sourcePoint"/><mxPoint x="685" y="1500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="19b. payment failed" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="1540" as="sourcePoint"/><mxPoint x="295" y="1540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="20b. show &#x27;Payment failed, try again&#x27; (cart kept)" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1580" as="sourcePoint"/><mxPoint x="100" y="1580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="alt  [payment]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=110;height=24;fillColor=none;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="920" width="1180" height="710" as="geometry"/></mxCell><mxCell id="c54" value="Figure 6: Sequence diagram – normal flow plus alternative flows: invalid coupon (10b), restaurant rejects (24b) and payment failed (17b)." style="text;html=1;fontSize=11;fontStyle=2;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1650" width="1150" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>