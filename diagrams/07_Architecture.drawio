geometry"/></mxCell><mxCell id="c33" value="Bottlenecks: single PostgreSQL instance at lunch/dinner peaks; free-tier limits on connections, realtime clients and Edge Function cold starts. Scale-up path: paid plan, connection pooling, read replicas, menu caching." style="text;html=1;fontSize=11;fontStyle=2;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1060" height="40" as="geometry"/></mxCell><mxCell id="c34" value="Figure 8: Three-layer client–server architecture with external payment service." style="text;html=1;fontSize=11;fontStyle=2;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1060" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>